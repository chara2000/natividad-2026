# ==============================================================================
# VARIABLES DE ENTORNO PARA NATIVIDAD PWA (NEXT.JS + SUPABASE + GPT LUNA 5.6)
# ==============================================================================

# 1. Supabase Database & Auth (Crea tu proyecto gratis en https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# 2. IA Engine: GPT Modelo Luna 5.6
OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL=luna-5.6
# Opcional: Si usas un endpoint personalizado o proxy compatible con OpenAI:
# AI_API_BASE_URL=https://api.openai.com/v1
